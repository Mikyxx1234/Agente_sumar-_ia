{
  "name": "agente-comercial-prompts",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma de agente comercial de IA: painel React/Vite para gerenciar prompts e diagnósticos, e backend Express que orquestra atendimento via WhatsApp (Evolution API), integração com CRM Kommo, persistência em Supabase e Redis, com tools de localização de polo, inscrição, distribuição para humano, Salesbot (busca em CSV) e schedulers de feedback comercial.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start-production.mjs",
    "start:local": "node --env-file=.env server.js",
    "db:ensure-inscricao-columns": "node --env-file=.env scripts/ensureDadosClienteInscricaoColumns.mjs",
    "db:ensure-captacao-curso": "node --env-file=.env scripts/ensureSumareCaptacaoCursoTable.mjs",
    "db:import-captacao-curso": "node --env-file=.env scripts/importSumareCaptacaoCurso.mjs",
    "db:seed-captacao-curso": "node --env-file=.env scripts/ensureSumareCaptacaoCursoTable.mjs && node --env-file=.env scripts/importSumareCaptacaoCurso.mjs",
    "db:ensure-feedback-job-runs": "node --env-file=.env scripts/ensureFeedbackJobRunsTable.mjs",
    "db:ensure-agent-prompts": "node --env-file=.env scripts/ensureAgentPrompts.mjs",
    "db:ensure-dashboard-metrics-rpc": "node --env-file=.env scripts/ensureDashboardMetricsRpc.mjs",
    "export:agent-prompts": "node --env-file=.env scripts/export-agent-prompts-snapshot.mjs",
    "import:agent-prompts": "node --env-file=.env scripts/import-agent-prompts-snapshot.mjs",
    "smoke:prod": "node scripts/smoke-prod-deploy.mjs",
    "test:inscricao-flow": "node scripts/test-inscricao-flow.mjs",
    "test:captacao-gerar-outcome": "node scripts/test-captacao-gerar-outcome.mjs",
    "test:outbound-dedupe-race": "node scripts/test-outbound-dedupe-race.mjs",
    "test:funnel-gate": "node scripts/test-kommo-agent-funnel-gate.mjs",
    "test:eduit-slice": "node scripts/test-eduit-crm-slice.mjs",
    "test:phone-variants": "node scripts/test-phone-whatsapp-variants.mjs",
    "backfill:eduit-ids": "node --env-file=.env scripts/backfill-eduit-ids.mjs",
    "test:flush-retry-backoff": "node scripts/test-flush-retry-backoff.mjs",
    "test:lgpd-compliance": "node scripts/test-lgpd-compliance.mjs",
    "test:form-notes-age-cap": "node scripts/test-form-notes-age-cap.mjs",
    "update:precos-rag": "node --env-file=.env scripts/update-precos-sumare-rag.mjs",
    "audit:precos": "node --env-file=.env scripts/audit-precos-sumare.mjs",
    "build:curso-perfil-grad": "node --env-file=.env scripts/build-curso-perfil-grad.mjs",
    "scrape:grade-curricular": "node scripts/scrape-grade-curricular-sumare.mjs",
    "scrape:grade-curricular-pos": "node scripts/scrape-grade-curricular-pos-sumare.mjs",
    "db:ensure-grade-curricular": "node --env-file=.env scripts/ensureGradGradeCurricularTable.mjs",
    "register:grade-curricular-rag": "node --env-file=.env scripts/register-grade-curricular-rag.mjs",
    "register:grade-curricular-pos-rag": "node --env-file=.env scripts/register-grade-curricular-pos-rag.mjs",
    "prune:stale-grade-rag": "node --env-file=.env scripts/prune-stale-grade-rag.mjs",
    "register:grade-curricular-rule30": "node --env-file=.env scripts/register-grade-curricular-rule30.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.510.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "pg": "^8.21.0",
    "vite": "^6.3.3"
  }
}
